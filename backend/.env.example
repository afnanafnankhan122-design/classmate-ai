# ==============================================================================
# ClassMate AI - Backend Environment Configuration Example
# Copy this file to backend/.env and provide your credentials.
# ==============================================================================

# Application environment ('development' or 'production')
ENVIRONMENT=development

# Database connection URL
# For SQLite local development: sqlite:///./classmate_ai.db
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/classmate_ai
DATABASE_URL=sqlite:///./classmate_ai.db

# Strong secret key for signing session cookies (generate with `secrets.token_urlsafe(32)`)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Fernet encryption key (32 url-safe base64-encoded bytes) used to encrypt Google OAuth tokens at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key-before-use

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Web application client ID (e.g. xxxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Web application client secret
GOOGLE_CLIENT_SECRET=

# Authorized OAuth redirect URI - Must match exactly with Google Cloud Console configuration
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (authorized JavaScript origin)
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated or JSON list of strings)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Default application timezone for formatting assignment deadlines (IANA timezone)
APP_TIMEZONE=Asia/Karachi

# Groq API key for future AI analysis modules (optional in Phase 2)
GROQ_API_KEY=

