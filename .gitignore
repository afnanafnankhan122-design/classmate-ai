# ==============================================================================
# ClassMate AI - Root Git Ignore Rules
# ==============================================================================

# Environment files & Secrets (Strictly Excluded)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Sensitive credentials, keys & certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
client_secret*.json
credentials*.json
token*.json
oauth_token*.json
service_account*.json

# SQLite Databases & Local Data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
classmate_ai.db
backend/classmate_ai.db

# Python & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
eggs/
.eggs/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
frontend/*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
.vercel

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
